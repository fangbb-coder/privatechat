# ============================================================
# Private Chat 环境配置示例
# 复制为 .env 并按实际填写。生产环境所有带 ❗的项必须显式设置。
# M6: 本文件与 backend/utils/config.py 中 Settings 字段保持同步。
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=Private Chat
APP_VERSION=3.6.1
# development / staging / production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

# ---------------- 密钥（H2: JWT 与 DB 加密分离）----------------
# ❗生产环境必须设置，长度 >= 32。留空则自动生成（重启后失效，仅适合开发）
SECRET_KEY=
# ❗生产环境必须设置，长度 >= 32。用于数据库字段加密，独立于 JWT 密钥
DB_ENCRYPTION_KEY=

# ---------------- 默认管理员（C3: 不再硬编码）----------------
ADMIN_USERNAMES=admin
# 首次启动创建管理员时使用的密码；留空则随机生成并打印一次
# ❗生产环境建议通过此变量注入，或留空让程序生成后立即登录修改
ADMIN_PASSWORD=

# ---------------- Token ----------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_ACTIVE_SESSIONS=5

# ---------------- 密码策略 ----------------
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=64
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# ---------------- 登录安全 ----------------
MAX_LOGIN_ATTEMPTS=5
# 登录失败锁定时长（分钟）
LOGIN_LOCK_MINUTES=15
# 基于 IP 的锁定阈值与时长
IP_LOCK_THRESHOLD=20
IP_LOCK_MINUTES=30

# ---------------- 速率限制 ----------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_IPS=10000
WS_CONNECTIONS_PER_MINUTE=20

# ---------------- 消息 ----------------
MESSAGE_RECALL_MINUTES=2
MAX_MESSAGE_LENGTH=5000
# M2: 内存中保留的最大消息条数，超出则淘汰最旧
MAX_STORED_MESSAGES=1000
# 消息默认加密密码（客户端未指定时使用）
DEFAULT_ENCRYPTION_KEY=PrivateChat2025Secure!

# ---------------- RSA ----------------
RSA_KEY_SIZE=2048
# RSA 密钥目录（默认 backend/keys）
# RSA_KEYS_DIR=./backend/keys

# ---------------- 数据库 ----------------
# DATABASE_PATH=./data/chat.db

# ---------------- CORS / Host（H3: 生产禁止 ["*"]）----------------
# 允许的来源（CORS），逗号分隔或 JSON 数组
ALLOWED_ORIGINS=
# 受信任主机（TrustedHostMiddleware），生产环境必须配置具体域名
ALLOWED_HOSTS=
# WebSocket 允许的来源
WS_ALLOWED_ORIGINS=*

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
# LOG_DIR=./logs
