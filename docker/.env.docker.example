# ============================================================
# Private Chat - Docker 部署环境变量
# 复制本文件为 .env，并按实际填写所有带 ❗的项
# 然后执行：docker compose up -d
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=Private Chat
APP_VERSION=3.6.1
ENVIRONMENT=production
# 宿主机映射端口
HOST_PORT=8080

# ---------------- 密钥（H2: JWT 与 DB 加密分离）❗必须设置 ----------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为生成的随机密钥_长度至少32
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=请替换为生成的随机密钥_长度至少32

# ---------------- 默认管理员（C3: 不再硬编码）----------------
ADMIN_USERNAMES=admin
# 首次启动创建管理员时使用的密码；留空则随机生成并打印在启动日志中（仅显示一次）
# ❗生产环境建议显式设置，或留空让程序生成后立即登录修改
ADMIN_PASSWORD=

# ---------------- Token ----------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_ACTIVE_SESSIONS=5

# ---------------- 密码策略 ----------------
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=64
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# ---------------- 登录安全 ----------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
IP_LOCK_THRESHOLD=20
IP_LOCK_MINUTES=30

# ---------------- 速率限制 ----------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_IPS=10000
WS_CONNECTIONS_PER_MINUTE=20

# ---------------- 消息 ----------------
MESSAGE_RECALL_MINUTES=2
MAX_MESSAGE_LENGTH=5000
MAX_STORED_MESSAGES=1000
DEFAULT_ENCRYPTION_KEY=PrivateChat2025Secure!

# ---------------- RSA ----------------
RSA_KEY_SIZE=2048

# ---------------- CORS / Host（H3: 生产禁止 ["*"]）❗必须配置具体域名 ----------------
# 多个域名用逗号分隔，例如：https://chat.example.com,https://chat2.example.com
ALLOWED_ORIGINS=https://chat.example.com
# 受信任主机，逗号分隔。建议包含 localhost,127.0.0.1 以供容器内健康检查通过
ALLOWED_HOSTS=chat.example.com,localhost,127.0.0.1
# WebSocket 允许的来源（可与 ALLOWED_ORIGINS 相同）
WS_ALLOWED_ORIGINS=https://chat.example.com

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
